{
  "name": "caseathon-drone-replay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "data": "python3 ../scripts/build_web_data.py ../data/raw/cmu_drone public/data && cd .. && python3 scripts/make_sim_failure.py",
    "model": "cd .. && python3 scripts/export_web_model.py",
    "scenarios": "cd .. && python3 scripts/export_web_scenarios.py",
    "results": "cd .. && python3 scripts/export_web_results.py",
    "synthetic": "cd .. && python3 scripts/export_web_synthetic.py",
    "envelope": "cd .. && python3 scripts/export_web_envelope.py"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  }
}
